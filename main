                    {q['net_ev_pct']:+.2f}%<br>
                    <small>({q['net_ev_usd']:+.4f}$)</small>
                </td>
                <td>${q['liq']:,}</td>
            </tr>"""

        btn_txt = (
            "🟢 BIG-RUNNER АВТОПИЛОТ АКТИВЕН (24/7)"
            if auto_on else "🔴 АВТОПИЛОТ НА ПАУЗЕ"
        )
        btn_col = "#16a34a" if auto_on else "#dc2626"
        p_col = "#4ade80" if total_pnl >= 0 else "#f87171"

        html = f"""<!DOCTYPE html><html><head><meta charset='utf-8'>
        <meta http-equiv='refresh' content='5'>
        <title>SolPulse Quant v5.2 (Big-Runner) — {SERVER_IP}</title>
